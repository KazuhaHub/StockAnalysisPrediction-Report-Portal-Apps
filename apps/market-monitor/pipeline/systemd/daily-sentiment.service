[Unit]
Description=日更 2/5 市场情绪监控面板
After=network-online.target daily-stock-server.service
Wants=network-online.target

[Service]
Type=oneshot
User=daily
Group=daily
WorkingDirectory=/opt/daily-tasks
Environment=HOME=/opt/daily-tasks
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
ExecStart=/bin/bash /opt/daily-tasks/bin/run_sentiment.sh
# 内含最多 30 分钟等行情库就绪
TimeoutStartSec=5400
Nice=10
