[Unit]
Description=日更 3/5 Panorama 全策略选股与十法估值
After=network-online.target daily-stock-server.service
Wants=network-online.target

[Service]
Type=oneshot
User=daily
Group=daily
WorkingDirectory=/opt/daily-tasks
Environment=HOME=/opt/daily-tasks
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
ExecStart=/bin/bash /opt/daily-tasks/bin/run_panorama.sh
# daily_update.sh 内含最多 25 分钟等写锁
TimeoutStartSec=7200
Nice=10
