[Unit]
Description=融资盘扫描兜底校验（仅在今天未成功更新时补跑）
After=network-online.target daily-margin.service
Wants=network-online.target

[Service]
Type=oneshot
User=daily
Group=daily
WorkingDirectory=/opt/daily-tasks
Environment=HOME=/opt/daily-tasks
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
ExecStart=/bin/bash /opt/daily-tasks/bin/margin_guard.sh
TimeoutStartSec=3600
Nice=10
