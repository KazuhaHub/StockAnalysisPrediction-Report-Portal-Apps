[Unit]
Description=日更 4/5 宽基 ETF 资金监测面板
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=daily
Group=daily
WorkingDirectory=/opt/daily-tasks
Environment=HOME=/opt/daily-tasks
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
ExecStart=/bin/bash /opt/daily-tasks/bin/run_etf.sh
TimeoutStartSec=5400
Nice=10
